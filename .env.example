# Base de Datos (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://usuario:contrasena@localhost:5432/nombre_db

# Cache y Candados Distribuidos (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Criptografía y JWT (Mínimo 32 caracteres)
JWT_SECRET=reemplazar_con_secreto_seguro_jwt_32_chars_min
PAQUETE_SECRET=reemplazar_con_secreto_seguro_aes_paquete

# Configuración de Servidor y CORS
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# Proveedores de Correo y Push
CORREO_BACKEND=mailpit
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
CORREO_REMITENTE=noreply@abogator.local
PUSH_BACKEND=simulado

# Superadministrador Inicial
ADMIN_EMAIL=admin@abogator.local
ADMIN_PASSWORD=contrasena_super_segura